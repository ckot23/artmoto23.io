# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не попадает (см. .gitignore) — токен бота остаётся только на сервере.

# Токен бота от @BotFather → /mybots → ваш бот → API Token.
BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Кому присылать заявки: ваш личный chat_id (узнать: напишите боту /id).
MODERATOR_ID=7114829971

# Порт и адрес сервера.
PORT=8080
HOST=0.0.0.0

# 1 — тестовый режим: заявки пишутся в лог и в orders.jsonl, в Telegram не уходят.
# 0 — боевой режим, заявки уходят модератору.
DRY_RUN=0

# 1 — слушать getUpdates (нужно, если заказы приходят из Telegram Mini App).
POLL=0

# Секрет для вебхука /api/tg-webhook (если используете вебхук вместо polling).
WEBHOOK_SECRET=

# Публичный адрес сайта — подставляется в приветствие бота.
PUBLIC_URL=

# Если сайт открыт с другого домена (например, GitHub Pages), укажите его origin,
# чтобы браузер разрешил запрос к этому серверу. Пусто — только свой домен.
ALLOW_ORIGIN=

# 1 — дублировать заявки в orders.jsonl рядом с сервером.
LOG_ORDERS=1
