# Скопируйте этот файл в .env и подставьте свои значения.
# .env в git не попадает (см. .gitignore) — токен бота остаётся только на сервере.
#
# ВАЖНО: никогда не коммитьте настоящий токен — даже в этот файл.
# Всё, что попало в репозиторий, считается утёкшим, и Telegram может отозвать
# токен сам. Если токен уже публиковался — отзовите его у @BotFather.

# Токен бота от @BotFather → /mybots → ваш бот → API Token.
# Формат: 1234567890:AAH...  (замените на свой)
BOT_TOKEN=

# Кому присылать заявки: ваш личный chat_id (узнать: напишите боту /id).
# Свой chat_id замените на своё число.
MODERATOR_ID=

# Порт и адрес сервера.
PORT=8080
HOST=0.0.0.0

# 1 — тестовый режим: заявки пишутся в лог и в orders.jsonl, в Telegram не уходят.
# 0 — боевой режим, заявки уходят модератору.
DRY_RUN=0

# Приём обновлений Telegram (заказы из Mini App, команды /start и /id):
#   auto — по умолчанию: есть вебхук → работаем через него, нет вебхука → слушаем сами;
#   1    — всегда слушать getUpdates (нужно, если сайт отправляет заказ через tg.sendData);
#   0    — не принимать обновления (заказы из Mini App потеряются).
POLL=auto

# Секрет для вебхука /api/tg-webhook (если используете вебхук вместо polling).
WEBHOOK_SECRET=

# 1 — сервер сам зарегистрирует вебхук на своём адресе при запуске
# (нужны WEBHOOK_SECRET и SERVER_URL). На Render адрес берётся из RENDER_EXTERNAL_URL,
# так что достаточно SERVER_URL=https://имя-сервиса.onrender.com либо просто WEBHOOK_AUTO=1.
WEBHOOK_AUTO=0

# Публичный адрес этого сервера — нужен, чтобы поставить вебхук (см. выше).
# Его же использует бот без сервера (bot.js, GitHub Actions): пока сервер жив
# и сам принимает обновления, бот пропускает запуск, чтобы не спорить за
# getUpdates (иначе оба процесса получают 409 Conflict и заявки теряются).
SERVER_URL=

# 1 (по умолчанию) — bot.js уступает работающему серверу (SERVER_URL).
# 0 — всегда пытаться забирать обновления самому (только если сервера нет:
# иначе начнётся 409 Conflict).
YIELD_TO_SERVER=1

# Публичный адрес сайта (HTTPS): подставляется в приветствие бота,
# с него же рисуется кнопка «Собрать наклейку» в /start.
# Домен нужно привязать к боту: @BotFather → /mybots → Bot Settings → Domain.
PUBLIC_URL=

# Если сайт открыт с другого домена (например, GitHub Pages), укажите его origin,
# чтобы браузер разрешил запрос к этому серверу. Пусто — только свой домен.
# Можно несколько через запятую: https://ckot23.github.io,https://artmoto23.ru
ALLOW_ORIGIN=

# 1 — дублировать заявки в orders.jsonl рядом с сервером.
LOG_ORDERS=1
